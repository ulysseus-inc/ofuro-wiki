generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String    @id @default(uuid()) @db.Uuid
  // #120: 大文字小文字を区別しない（citext）。
  // アプリ側の正規化だけでは入口を1つ足し忘れれば穴が残るため、DB の型で強制する。
  email                  String    @unique @db.Citext
  name                   String?   @db.VarChar(255)
  avatarUrl              String?   @map("avatar_url")
  passwordHash           String?   @map("password_hash")
  emailVerified          Boolean   @default(false) @map("email_verified")
  // L-1: JWT 即時失効用。パスワード変更/全端末サインアウト/管理者失効で +1 し、
  // 発行済みトークン(payload.tv)と不一致なら失効扱いにする。
  tokenVersion           Int       @default(0) @map("token_version")
  // #93: ログイン失敗の連続回数と一時ロック。既定は 10回失敗で 15分ロック（自動解除）。
  // ロック解除時・ログイン成功時・パスワードリセット完了時に 0 へ戻す。
  failedLoginCount       Int       @default(0) @map("failed_login_count")
  lockedUntil            DateTime? @map("locked_until") @db.Timestamptz()
  lastFailedLoginAt      DateTime? @map("last_failed_login_at") @db.Timestamptz()
  isAdmin                Boolean   @default(false) @map("is_admin")
  // #72: マニュアルWS所有などのシステム内部アカウント。ログイン不可・Admin一覧から除外。
  isSystem               Boolean   @default(false) @map("is_system")
  receiveInvitationEmail Boolean   @default(false) @map("receive_invitation_email")
  receiveMentionEmail    Boolean   @default(false) @map("receive_mention_email")
  receiveCommentEmail    Boolean   @default(false) @map("receive_comment_email")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]
  sessions        Session[]
  docSnapshots    DocSnapshot[]
  docUpdates      DocUpdate[]
  docHistories    DocHistory[]
  createdDocs     DocMeta[]         @relation("DocCreatedBy")
  updatedDocs     DocMeta[]         @relation("DocUpdatedBy")
  docPermissions  DocPermission[]
  invitationsSent Invitation[]
  userSpaces      UserSpace[]
  comments        Comment[]         @relation("CommentAuthor")
  replies         Reply[]           @relation("ReplyAuthor")
  notifications   Notification[]
  emailTokens     EmailToken[]

  @@map("users")
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String?  @db.VarChar(255)
  avatarKey String?  @map("avatar_key")
  public    Boolean  @default(false)
  ownerId   String   @map("owner_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  /// #151: Discovery Index の版数。クライアントのキャッシュが古いことを検出する。
  ///
  /// ⚠️ **権限変更だけでなく、Index の内容が変わったときも上げること。**
  /// 上げないと「権限は正しいのに一覧が古い」状態になる
  /// （docs/doc-permission.md「Discovery Index Local Cache」4）。
  ///
  /// ⚠️ ワークスペース単位のため、1人の権限を変えると全員のキャッシュが失効する。
  /// 正しさを優先した割り切りで、利用者単位への細分化は**最初からやらない**。
  discoveryRevision BigInt @default(0) @map("discovery_revision")

  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members     WorkspaceMember[]
  snapshots   DocSnapshot[]
  updates     DocUpdate[]
  histories   DocHistory[]
  docs        DocMeta[]
  blobs       Blob[]
  invitations Invitation[]
  userSpaces  UserSpace[]
  searchIndex SearchIndex[]
  comments    Comment[]

  @@index([ownerId], map: "idx_workspaces_owner")
  @@map("workspaces")
  searchIndexQueues SearchIndexQueue[]
}

model WorkspaceMember {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  role        String   @default("member") @db.VarChar(50)
  status      String   @default("accepted") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model DocSnapshot {
  workspaceId String   @map("workspace_id") @db.Uuid
  docId       String   @map("doc_id") @db.VarChar(255)
  blob        Bytes
  timestamp   DateTime @default(now()) @db.Timestamptz()
  editorId    String?  @map("editor_id") @db.Uuid

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  editor    User?     @relation(fields: [editorId], references: [id])

  @@id([workspaceId, docId])
  @@index([editorId], map: "idx_doc_snapshots_editor")
  @@map("doc_snapshots")
}

model DocUpdate {
  id          BigInt   @id @default(autoincrement())
  workspaceId String   @map("workspace_id") @db.Uuid
  docId       String   @map("doc_id") @db.VarChar(255)
  blob        Bytes
  timestamp   DateTime @default(now()) @db.Timestamptz()
  editorId    String?  @map("editor_id") @db.Uuid

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  editor    User?     @relation(fields: [editorId], references: [id])

  @@index([workspaceId, docId, timestamp], map: "idx_doc_updates_lookup")
  @@map("doc_updates")
}

model DocHistory {
  id          BigInt   @id @default(autoincrement())
  workspaceId String   @map("workspace_id") @db.Uuid
  docId       String   @map("doc_id") @db.VarChar(255)
  blob        Bytes
  timestamp   DateTime @db.Timestamptz()
  editorId    String?  @map("editor_id") @db.Uuid

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  editor    User?     @relation(fields: [editorId], references: [id])

  @@index([workspaceId, docId, timestamp], map: "idx_doc_histories_lookup")
  @@index([editorId], map: "idx_doc_histories_editor")
  @@map("doc_histories")
}

model DocMeta {
  workspaceId String   @map("workspace_id") @db.Uuid
  docId       String   @map("doc_id") @db.VarChar(255)
  title       String?
  mode        String   @default("page") @db.VarChar(20)
  public      Boolean  @default(false)
  // #97: NULL = 未設定（ワークスペースのロールが効く）。
  // ⚠️ 既定値を入れてはいけない。入れると全 doc が「設定済み」になり、
  // 所有者まで Reader に降格する（docs/doc-permission.md 4.2）
  defaultRole String?  @map("default_role") @db.VarChar(50)
  // #151: Discovery Metadata。タグの「紐付け」をサーバー側で持つ。
  // ⚠️ タグの定義（名前・色）は権限に関係しない共有情報のため対象外
  //（`meta.properties.tags.options` に残す）。ここは doc → タグID の対応のみ。
  // ⚠️ migration.sql の DEFAULT '{}' と揃えること。揃えないと
  // 次の `prisma migrate dev` が「既定値を消す」差分を生成する
  tagIds      String[] @default([]) @map("tag_ids")
  // #151: ゴミ箱に入っているか。Yjs 目次（meta.pages[].trash）から写す。
  // ⚠️ 一覧はこれで絞る。写さないと**削除したページが一覧に復活する**
  trash       Boolean  @default(false)
  // #151 段階3: フィールド単位の版数。用途は2つある（docs/discovery-stage3-comparison.md 7.5.10 / 7.7）
  //
  // 1. 競合制御（恒久）… その変更が「そのフィールドの現在値を基準にしたもの」か
  //    を確かめる。ワークスペース単位の discoveryRevision は使えない
  //    （他人の無関係な変更で上がり、ほとんどの書き込みが弾かれる）
  //
  // 2. 移行判定（⚠️ PR1〜PR5 の期間限定）… 0 なら Yjs 目次が正で
  //    doc-meta-sync が写す。0 より大きければ doc_meta が正で上書きしない
  //
  // ⚠️ **2 を恒久的な所有権モデルとして扱わないこと。** Yjs 目次を廃止したら
  //    この判定ごと捨て、1 の役割だけが残る
  //
  // ⚠️ tagsRevision は **移行判定にのみ**使う。tags は add/remove の操作型で
  //    順序に依存しないため、競合制御に版数は要らない
  titleRevision BigInt @default(0) @map("title_revision")
  trashRevision BigInt @default(0) @map("trash_revision")
  tagsRevision  BigInt @default(0) @map("tags_revision")
  createdById String?  @map("created_by") @db.Uuid
  updatedById String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User?           @relation("DocCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?           @relation("DocUpdatedBy", fields: [updatedById], references: [id])
  permissions DocPermission[]

  @@id([workspaceId, docId])
  @@index([createdById], map: "idx_doc_meta_created_by")
  @@index([updatedById], map: "idx_doc_meta_updated_by")
  @@map("doc_meta")
}

model DocPermission {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  docId       String   @map("doc_id") @db.VarChar(255)
  userId      String   @map("user_id") @db.Uuid
  role        String   @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  doc  DocMeta @relation(fields: [workspaceId, docId], references: [workspaceId, docId], onDelete: Cascade)
  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, docId, userId])
  @@index([userId], map: "idx_doc_permissions_user")
  @@map("doc_permissions")
}

model Blob {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  key         String   @db.VarChar(255)
  mime        String?  @db.VarChar(255)
  size        BigInt?
  storagePath String   @map("storage_path")
  deleted     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@map("blobs")
}

model Invitation {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  inviterId   String    @map("inviter_id") @db.Uuid
  // #120: users.email と同じ扱いに揃える（#148 で宛先を照合するため）
  email       String?   @db.Citext
  role        String    @default("member") @db.VarChar(50)
  expireTime  DateTime? @map("expire_time") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter   User      @relation(fields: [inviterId], references: [id])

  @@index([workspaceId], map: "idx_invitations_workspace")
  @@index([inviterId], map: "idx_invitations_inviter")
  @@map("invitations")
}

model UserSpace {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@map("user_spaces")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz()
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_sessions_user")
  @@index([expiresAt], map: "idx_sessions_expires")
  @@map("sessions")
}

model SearchIndex {
  id          BigInt   @id @default(autoincrement())
  workspaceId String   @map("workspace_id") @db.Uuid
  docId       String   @map("doc_id") @db.VarChar(255)
  blockId     String?  @map("block_id") @db.VarChar(255)
  title       String?
  content     String
  blockType   String?  @map("block_type") @db.VarChar(50)

  // #101: バックリンク。リンク元のブロックから、リンク先のページを引く
  refDocId       String? @map("ref_doc_id") @db.VarChar(255)
  ref            String?
  parentBlockId  String? @map("parent_block_id") @db.VarChar(255)
  parentFlavour  String? @map("parent_flavour") @db.VarChar(50)
  additional     String?
  markdownPreview String? @map("markdown_preview")
  summary        String?

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, docId], map: "idx_search_workspace")
  // #101: 「このページを参照しているブロック」を引くための索引
  @@index([workspaceId, refDocId], map: "idx_search_ref_doc")
  @@map("search_index")
}

/// #101: 索引の作り直し待ち（docs/search-index.md 5章）
///
/// ⚠️ doc_meta に相乗りしない。台帳の行が無いページが過去に存在し、
/// 相乗りすると取りこぼす。
model SearchIndexQueue {
  workspaceId String @map("workspace_id") @db.Uuid
  docId       String @map("doc_id") @db.VarChar(255)

  /// 編集のたびに +1。本文の保存と同一トランザクションで進める
  pendingGeneration BigInt   @default(1) @map("pending_generation")
  /// 作り直せた世代。pending > indexed が「作り直しが要る」
  indexedGeneration BigInt   @default(0) @map("indexed_generation")
  /// 最後の編集時刻。静まったかの判定に使う
  pendingAt         DateTime @default(now()) @map("pending_at") @db.Timestamptz()

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, docId])
  @@index([pendingAt], map: "idx_search_queue_pending")
  @@map("search_index_queue")
}

model ServerSetting {
  key       String   @id @db.VarChar(255)
  value     String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("server_settings")
}

model BackupRecord {
  id             String   @id @default(uuid()) @db.Uuid
  filename       String
  size           BigInt
  workspaceCount Int      @map("workspace_count")
  docCount       Int      @map("doc_count")
  blobCount      Int      @map("blob_count")
  status         String   @default("completed") @db.VarChar(50)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  createdBy      String?  @map("created_by") @db.Uuid

  @@map("backup_records")
}

model Comment {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  docId       String   @map("doc_id") @db.VarChar(255)
  userId      String   @map("user_id") @db.Uuid
  content     Json     @db.JsonB
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("CommentAuthor", fields: [userId], references: [id], onDelete: Cascade)
  replies   Reply[]

  @@index([workspaceId, docId], map: "idx_comment_workspace_doc")
  @@map("comments")
}

model Reply {
  id        String   @id @default(uuid()) @db.Uuid
  commentId String   @map("comment_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  content   Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation("ReplyAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@index([commentId], map: "idx_replies_comment")
  @@index([userId], map: "idx_replies_user")
  @@map("replies")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String   @db.VarChar(50)
  level     String   @default("Default") @db.VarChar(20)
  body      Json     @db.JsonB
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt], map: "idx_notification_user")
  @@map("notifications")
}

model EmailToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(255)
  type      String   @db.VarChar(50)
  email     String?  @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz()
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt], map: "idx_email_tokens_expires")
  @@map("email_tokens")
}

/// #90: 監査ログ。「誰が・いつ・何をしたか」の記録（docs/logging.md 2章）。
///
/// ⚠️ actorEmail / actorName / targetName は**当時の値**を文字列で保持する。
/// 外部キーの参照だけだと、利用者の削除や氏名変更で「当時誰だったか」が
/// 分からなくなり、監査ログとして成立しない。
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  actorEmail  String   @map("actor_email") @db.VarChar(255)
  actorName   String?  @map("actor_name") @db.VarChar(255)
  action      String   @db.VarChar(64)
  targetType  String?  @map("target_type") @db.VarChar(32)
  targetId    String?  @map("target_id") @db.VarChar(255)
  targetName  String?  @map("target_name") @db.VarChar(255)
  workspaceId String?  @map("workspace_id") @db.Uuid
  ip          String?  @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(255)
  detail      Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
