# =============================================================
# ofuro-wiki バックエンド 環境変数テンプレート
# このファイルをコピーして .env を作成してください
# cp .env.example .env
# =============================================================

# ----- データベース -----
# PostgreSQL パスワード（docker-compose でも使用）
# 生成コマンド: openssl rand -base64 24
POSTGRES_PASSWORD="CHANGE_ME_DB_PASSWORD"

# PostgreSQL 接続URL（POSTGRES_PASSWORD と同じパスワードを設定）
# ホスト側（ローカル開発・Prisma CLI 等）での実行用。ホスト名は localhost。
DATABASE_URL="postgresql://ofuro:CHANGE_ME_DB_PASSWORD@localhost:5432/ofuro_wiki"

# ----- Docker Compose 経由の接続上書き（通常は不要） -----
# docker-compose.yml は既定で app→postgres サービス(@postgres:5432)に接続する。
# ホスト側 DATABASE_URL(=localhost) がコンテナに漏れるのを防ぐため、コンテナの
# 接続先上書きは専用の DOCKER_ 変数で行う。最小権限化(#34 フェーズ2)で runtime を
# 非superuser(ofuro_app)に切替える場合のみ、以下を設定する:
# DOCKER_DATABASE_URL="postgresql://ofuro_app:CHANGE_ME_APP_PASSWORD@postgres:5432/ofuro_wiki"
# migrate deploy(DDL) は DDL 権限を持つロール(ofuro)で実行する:
# DOCKER_MIGRATE_DATABASE_URL="postgresql://ofuro:CHANGE_ME_DB_PASSWORD@postgres:5432/ofuro_wiki"

# #34: バックアップ(pg_dump)/リストア(pg_restore)用の接続URL（任意）。
# 全スキーマを読む/DDLするため、最小権限化で DATABASE_URL を非superuser にした場合は
# DDL権限を持つロール(ofuro)が必要。未設定なら MIGRATE_DATABASE_URL→DATABASE_URL の順で
# フォールバックする（MIGRATE_DATABASE_URL を設定済みなら通常は指定不要）。
# BACKUP_DATABASE_URL="postgresql://ofuro:CHANGE_ME_DB_PASSWORD@localhost:5432/ofuro_wiki"
# Docker 経由で上書きする場合（ホスト名は postgres）:
# DOCKER_BACKUP_DATABASE_URL="postgresql://ofuro:CHANGE_ME_DB_PASSWORD@postgres:5432/ofuro_wiki"

# PostgreSQL のポート公開範囲。
# 既定はループバック限定（127.0.0.1:5432:5432）。アプリは compose ネットワーク
# 経由で接続するため、通常は変更不要。
# ⚠️ 社内LANの別ホストから DB へ直接つなぐ構成でのみ設定する。
#    全公開(0.0.0.0)は避け、信頼できるIPに絞ること:
# POSTGRES_PUBLISH=<server-ip>:5432:5432

# ----- セキュリティ -----
# JWT署名シークレット（本番では必ず強いランダム値を設定）
# 生成コマンド: openssl rand -base64 48
JWT_SECRET="CHANGE_ME_STRONG_RANDOM_SECRET"

# ----- CORS -----
# * : 全てのオリジンを許可（デフォルト）
# ドメインを絞る場合はカンマ区切りで指定
# ALLOWED_ORIGINS=https://wiki.example.com
# ALLOWED_ORIGINS=https://wiki.example.com,https://wiki2.example.com
ALLOWED_ORIGINS=*

# ----- リバースプロキシ -----
# #93: Nginx / Caddy 等のリバースプロキシ配下で動かす場合に設定する。
# 有効にすると X-Forwarded-For からクライアントIPを解決し、ログインの
# レート制限が「利用者ごと」に効くようになる。
#
# 未設定のままプロキシ配下で運用すると、全アクセスがプロキシのIPとして
# 扱われ、レート制限が利用者全員の合計として働いてしまう。
#
# ⚠️ 直接インターネットに公開しているサーバーでは設定しないこと。
#    X-Forwarded-For を偽装され、レート制限を回避されます。
# 値はプロキシの段数（通常は 1）
# TRUST_PROXY=1

# ----- アプリケーション -----
# 注: Docker（docker compose）運用では compose が NODE_ENV=production を設定するため、
#     この値は使われません。ここはローカル開発（npm run start:dev）専用の設定です。
#     production にすると COOKIE_SECURE が既定 true になり、http://localhost の開発で
#     ログインできなくなるため development のままにしてください。
NODE_ENV="development"
PORT=3010

# クッキーのセキュアフラグ（HTTPS環境では true、HTTP環境では false）
# 未設定の場合: NODE_ENV=production なら true、それ以外は false
# HTTPS（本番/GCE）: COOKIE_SECURE=true  ← 省略可
# HTTP（社内ローカル等）: COOKIE_SECURE=false
# COOKIE_SECURE=false

# サーバーのベースURL（メール内リンク生成に使用）
BASE_URL="http://localhost:8080"

# ストレージパス
BLOB_STORAGE_PATH="./data/blobs"
BACKUP_STORAGE_PATH="./data/backups"

# アプリバージョン
# 通常は設定不要。Docker イメージのビルド時に焼き込まれた値が使われる
# （リリース版イメージなら Git タグの版数、開発ビルドなら 0.0.0-dev）。
# ソースからビルドする場合に版数を明示したいときだけ設定する:
#   APP_VERSION=0.1.0 docker compose build
# ※ AFFINE_API_VERSION（config.service.ts）は別物。フォーク元 AFFiNE との
#   通信プロトコル互換用であり、絶対に変更しないこと
# APP_VERSION=0.1.0

# ----- 性能 -----
# パスワード照合(bcrypt)やファイルI/O が使うスレッド数。
#
# ⚠️ **通常は設定不要。** 未設定なら CPU コア数から自動で決まる（下限4・上限16）。
#    起動ログで確認できる: docker compose logs app | grep スレッドプール
#
# Node の既定は 4 で、CPU が何コアあっても**同時4件までしか
# パスワード照合できない**（bcrypt は1回 約300ms）。始業時の一斉ログインで
# 後の利用者ほど待たされるため、ofuro-wiki は自動で広げている。
#
# 実測して値を固定したいときだけ指定する。
# ⚠️ コア数を大きく超える値にしても速くならない（待ち行列が伸びるだけ）。
# UV_THREADPOOL_SIZE=16

# ----- ログ -----
# 保存先は Docker では compose が /data/logs に固定する（ボリュームで永続化）。
# ローカル開発では backend/data/logs に出る。docs/logging.md を参照。
#
# 保持日数（既定 90）。日次で gzip し、期間を過ぎたものを削除する。
# ⚠️ 監査ログ（DB）とは別物。こちらはアクセスログ・アプリケーションログ。
# LOG_RETENTION_DAYS=90
#
# 出力レベル。既定は error / warn / log まで。
# 障害調査で詳細を見たいときだけ debug にする（出力量が大きく増える）。
# LOG_LEVEL=debug

# ----- 表示 -----
# 新規利用者の既定の表示言語（未設定なら ja）。
# DEFAULT_LANGUAGE=en

# ----- 管理者 -----
# 初回起動時に Admin として登録するメールアドレス
# ADMIN_EMAIL=admin@example.com

# ----- 認証 -----
# sign-in 時に未登録メールを自動でアカウント作成するか（既定: true）。
# false にすると sign-in では作成せず、未登録メールも「Invalid credentials」で
# 一律に扱う（招待制運用など、自己登録を厳格に絞りたい場合に推奨）。
# AUTH_SIGNIN_AUTOCREATE=false

# ----- 不審なログイン試行の検知（#117）- オプション -----
# 総当たり・パスワードスプレー等を検知して Admin にメール通知する。
# 既定値のままで動くため、通常は設定不要。docs/intrusion-detection.md を参照。
#
# ⚠️ 通知にはメール設定（下記 SMTP）が必要。未設定だと検知しても届かない。
#
# 検知の集計期間（分）
# ALERT_WINDOW_MINUTES=60
# 終息通知までの静穏時間（分）。この間に新たな試行が無ければ「終息」を送る
# ALERT_RESOLVE_QUIET_MINUTES=30
# 同一アカウントのロック回数
# ALERT_LOCK_THRESHOLD=3
# 単一IPから狙われた異なるアカウント数（パスワードスプレー）
# ALERT_SPRAY_ACCOUNT_THRESHOLD=20
# レート制限に達した回数
# ALERT_THROTTLE_THRESHOLD=100
# 未登録メールアドレスでの試行回数（アカウント列挙）
# ALERT_UNKNOWN_EMAIL_THRESHOLD=50
#
# ⚠️ しきい値に 0 や負数は指定しないこと（既定値に倒される）。
#    0 は「常に検知」を意味し、通知が止まらなくなる。
#
# 検知そのものを止める（true のときだけ無効）
# ALERT_DISABLED=false

# ----- メール（SMTP）- オプション -----
# 未設定の場合はメール機能（招待メール・パスワードリセットメール）が無効になります。
# SMTP なしでも運用可能です:
#   - 既登録ユーザーの招待: メールに関係なく即時メンバー登録される（相手には次回アクセス時に表示）
#   - 未登録ユーザーの招待: 「メンバーを招待」から発行できる招待リンクをチャット等で共有する
#   - パスワードリセット: Admin が再設定用URLを発行し、本人にチャット等で共有する
# MAILER_HOST=smtp.example.com
# MAILER_PORT=587
# MAILER_USER=user@example.com
# MAILER_PASSWORD=smtp_password
# MAILER_SENDER="ofuro-wiki <noreply@example.com>"
# MAILER_IGNORE_TLS=false
